# --- \uc0\u20126 \u30436 \u26680 \u24515 \u35336 \u20998 \u37007 \u36655 \u31639 \u27861  ---\
def calculate_handicap_score(home_score, away_score, handicap, is_home_favorite, bet_choice):\
    """\
    \uc0\u22238 \u20659 \u35442 \u22580 \u25237 \u27880 \u30340 \u24471 \u20998 : \u36111 \u20840 (10), \u36111 \u21322 (5), \u36208 \u30436 (0), \u36664 \u21322 (-5), \u36664 \u20840 (-10)\
    """\
    if bet_choice == "\uc0\u26410 \u36984 \u25799 ":\
        return 0\
        \
    # \uc0\u31639 \u20986 \u28136 \u21213 \u29699  (\u20027 \u38538 \u27604 \u25976  - \u23458 \u38538 \u27604 \u25976 )\
    goal_diff = home_score - away_score\
    \
    # \uc0\u23559 \u30436 \u21475 \u23383 \u20018 \u36681 \u25104 \u25976 \u23383  (\u20363 \u22914 : "-0.75" \u36681 \u25104  -0.75, "+0.5" \u36681 \u25104  0.5)\
    # \uc0\u25903 \u25588 \u24120 \u35215 \u21934 \u30436 \u22914  -0.5, -1, +0.25 \u31561 \u12290 \u22914 \u26524 \u26159 \u38617 \u30436 \u22914  -0.5/-1\u65292 \u35531 Admin\u22312 \u24460 \u21488 \u30452 \u25509 \u36664 \u20837 \u20854 \u24179 \u22343 \u20540  -0.75\
    try:\
        h_num = float(handicap)\
    except:\
        return 0 # \uc0\u30436 \u21475 \u26684 \u24335 \u37679 \u35492 \u26178 \u38450 \u21574 \
        \
    # \uc0\u35336 \u31639 \u35731 \u29699 \u24460 \u30340 \u24046 \u36317  (\u23565 \u19978 \u30436 \u38538 \u20237 \u32780 \u35328 )\
    # \uc0\u22914 \u26524 \u20027 \u38538 \u26159 \u35731 \u29699 \u26041 \u65292 \u20027 \u38538 \u28136 \u21213 \u29699 \u35201 \u21152 \u19978 \u30436 \u21475 \u25976 \u23383 (\u30436 \u21475 \u36890 \u24120 \u26159 \u36000 \u25976 )\
    if is_home_favorite:\
        final_diff = goal_diff + h_num  # \uc0\u20363 : \u20027 \u36111  1 \u29699 \u65292 \u30436 \u21475  -0.75 -> 1 + (-0.75) = +0.25\
    else:\
        # \uc0\u22914 \u26524 \u23458 \u38538 \u26159 \u35731 \u29699 \u26041 \u65292 \u23458 \u38538 \u28136 \u21213 \u29699 (\u21363  -goal_diff) \u21152 \u19978 \u30436 \u21475 \u25976 \u23383 \
        final_diff = (-goal_diff) + h_num\
\
    # \uc0\u21028 \u26039 \u19978 \u30436 \u30340 \u36664 \u36111 \u29376 \u24907 \
    if final_diff >= 0.5:\
        top_status = "\uc0\u36111 \u20840 "\
    elif final_diff == 0.25:\
        top_status = "\uc0\u36111 \u21322 "\
    elif final_diff == 0:\
        top_status = "\uc0\u36208 \u30436 "\
    elif final_diff == -0.25:\
        top_status = "\uc0\u36664 \u21322 "\
    else:\
        top_status = "\uc0\u36664 \u20840 "\
\
    # \uc0\u26681 \u25818 \u29609 \u23478 \u36023 \u19978 \u30436 \u23450 \u19979 \u30436 \u30332 \u25918 \u20998 \u25976 \
    if "\uc0\u19978 \u30436 " in bet_choice:\
        if top_status == "\uc0\u36111 \u20840 ": return 10\
        if top_status == "\uc0\u36111 \u21322 ": return 5\
        if top_status == "\uc0\u36208 \u30436 ": return 0\
        if top_status == "\uc0\u36664 \u21322 ": return -5\
        if top_status == "\uc0\u36664 \u20840 ": return -10\
    elif "\uc0\u19979 \u30436 " in bet_choice:\
        if top_status == "\uc0\u36111 \u20840 ": return -10  # \u19978 \u30436 \u36111 \u20840 \u65292 \u19979 \u30436 \u23601 \u36664 \u20840 \
        if top_status == "\uc0\u36111 \u21322 ": return -5   # \u19978 \u30436 \u36111 \u21322 \u65292 \u19979 \u30436 \u23601 \u36664 \u21322 \
        if top_status == "\uc0\u36208 \u30436 ": return 0\
        if top_status == "\uc0\u36664 \u21322 ": return 5    # \u19978 \u30436 \u36664 \u21322 \u65292 \u19979 \u30436 \u23601 \u36111 \u21322 \
        if top_status == "\uc0\u36664 \u20840 ": return 10   # \u19978 \u30436 \u36664 \u20840 \u65292 \u19979 \u30436 \u23601 \u36111 \u20840 \
        \
    return 0\
\
